{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Actualizar app (mensual)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/actualizar.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Actualizar app (forzar todo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/actualizar.py",
      "args": ["--forzar"],
      "console": "integratedTerminal"
    }
  ]
}
